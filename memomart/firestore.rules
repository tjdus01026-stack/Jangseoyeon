rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Memos: everyone can read. Signed-in visitors can post their own.
    // Only the author can edit / re-price / delete. Others may only
    // add reviews and bump the view counter.
    match /memos/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && (
                      (resource.data.owner == request.auth.uid
                        && request.resource.data.owner == request.auth.uid)
                      || request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['reviews', 'views', 'lastViewedAt'])
                    );
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }

    // Combo packs: everyone can read; only the author can change them.
    match /sets/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }
  }
}
